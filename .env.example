# Copy this file to .env and add your API key.
OPENAI_API_KEY=

# Optional OpenAI-compatible endpoint and model overrides:
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_REASONING_EFFORT=medium

# For Groq, set GROQ_API_KEY instead of OPENAI_API_KEY.
# Groq endpoint/model are selected automatically when only GROQ_API_KEY is set.
# Optional overrides:
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=qwen/qwen3.8-27b
GROQ_API_KEY=
